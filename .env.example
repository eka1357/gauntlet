NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
TAVILY_API_KEY=

# Safeguards & API controls
# Live runs are disabled unless LIVE_RUNS_ENABLED is exactly "true" (case-insensitive)
LIVE_RUNS_ENABLED=false
# Only trust X-Forwarded-For header when behind a trusted reverse proxy
TRUSTED_PROXY=false
# Global daily live run spend cap in USD
DAILY_SPEND_CAP_USD=0.50
